@model EnrolmentsPageViewModel
@{
    ViewData["Title"] = "Enrolments";
    var active = Model.Enrolments.Count(e => e.Status != "Cancelled");
}
<div class="page-header">
    <a asp-controller="Enrolments" asp-action="Index" class="back-link">&larr; All events</a>
    <h1>Enrolments</h1>
    <p>@Model.Event.Name &middot; @Model.Event.Date.ToString("d MMM yyyy") &middot; @active active enrolment@(active == 1 ? "" : "s")</p>
</div>

@if (!Model.Enrolments.Any())
{
    <div class="empty-state"><p>Nobody has enrolled for this event yet.</p></div>
}
else
{
    <div class="panel">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Participant</th><th>Category</th><th>Enrolled</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    <tr>
                        <td><strong>@e.ParticipantName</strong><div class="small text-muted">@e.Email@(string.IsNullOrWhiteSpace(e.Phone) ? "" : " · " + e.Phone)</div></td>
                        <td>@e.CategoryName</td>
                        <td>@e.EnrolDate.ToString("d MMM yyyy")</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end">
                            <form asp-action="UpdateStatus" method="post" class="d-inline-flex gap-1">
                                <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                                <select name="status" class="form-select form-select-sm" aria-label="Change status">
                                    @foreach (var s in EventOptions.Statuses)
                                    {
                                        <option value="@s" selected="@(s == e.Status)">@s</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-outline-dark btn-sm">Update</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
