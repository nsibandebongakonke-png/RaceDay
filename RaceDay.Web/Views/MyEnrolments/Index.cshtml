@model List<MyEnrolmentDto>
@{
    ViewData["Title"] = "My enrolments";
}
<div class="page-header">
    <h1>My enrolments</h1>
    <p>Every event you have enrolled for, and where each enrolment stands.</p>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <p>You have not enrolled for any events yet.</p>
        <a asp-controller="Events" asp-action="Index" class="btn btn-raceday">Browse events</a>
    </div>
}
else
{
    <div class="panel">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Enrolled on</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId"><strong>@e.EventName</strong></a><div class="small text-muted">@e.Location</div></td>
                        <td>@e.EventDate.ToString("d MMM yyyy")</td>
                        <td>@e.CategoryName</td>
                        <td>@e.EnrolDate.ToString("d MMM yyyy")</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end">
                            @if ((e.Status == "Pending" || e.Status == "Confirmed") && e.EventDate >= DateTime.Now)
                            {
                                <form asp-action="Cancel" asp-route-id="@e.EnrolmentId" method="post" class="d-inline"
                                      data-confirm="Cancel your enrolment for &quot;@e.EventName&quot;?">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
