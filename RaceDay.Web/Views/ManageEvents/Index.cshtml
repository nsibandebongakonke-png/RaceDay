@model ManageEventsViewModel
@{
    ViewData["Title"] = "Manage events";
}
<div class="page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h1>Events</h1>
        <p>Create, edit and delete your events.</p>
    </div>
    <a asp-action="Create" class="btn btn-raceday">+ New event</a>
</div>

@if (!Model.Events.Any())
{
    <div class="empty-state">
        <p>You have not created any events yet.</p>
        <a asp-action="Create" class="btn btn-raceday">Create your first event</a>
    </div>
}
else
{
    <div class="panel">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Event</th><th>Date</th><th>Type</th><th>Distance</th><th class="text-center">Categories</th><th class="text-center">Enrolled</th><th></th></tr></thead>
                <tbody>
                @foreach (var ev in Model.Events.OrderByDescending(e => e.Date))
                {
                    <tr>
                        <td><strong>@ev.Name</strong><div class="small text-muted">@ev.Location</div></td>
                        <td>@ev.Date.ToString("d MMM yyyy HH:mm")</td>
                        <td><span class="type-pill type-@ev.EventType.ToLowerInvariant()">@ev.EventType</span></td>
                        <td>@ev.Distance</td>
                        <td class="text-center">@ev.CategoryCount</td>
                        <td class="text-center">@ev.EnrolmentCount</td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@ev.EventId" class="btn btn-outline-dark btn-sm">Categories</a>
                            <a asp-action="Edit" asp-route-id="@ev.EventId" class="btn btn-outline-dark btn-sm">Edit</a>
                            <button type="button" class="btn btn-outline-danger btn-sm"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    data-event-id="@ev.EventId" data-event-name="@ev.Name">Delete</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Delete" method="post" class="modal-content" id="deleteForm">
            <div class="modal-header">
                <h2 class="modal-title h5">Delete event?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>This permanently deletes <strong id="deleteEventName"></strong>, its categories, enrolments and results.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete event</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            document.getElementById('deleteEventName').textContent = button.getAttribute('data-event-name');
            document.getElementById('deleteForm').setAttribute('action', '@Url.Action("Delete", "ManageEvents")/' + button.getAttribute('data-event-id'));
        });
    </script>
}
