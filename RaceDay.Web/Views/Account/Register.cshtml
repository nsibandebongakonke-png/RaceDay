@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="auth-wrap">
    <div class="auth-card auth-card-wide">
        <h1>Create your account</h1>
        <p class="text-muted">Choose how you will use RaceDay.</p>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <div class="role-choice">
                    <label class="role-option">
                        <input type="radio" asp-for="Role" value="Participant" />
                        <span><strong>Participant</strong><small>Enrol in events and view my results</small></span>
                    </label>
                    <label class="role-option">
                        <input type="radio" asp-for="Role" value="Organiser" />
                        <span><strong>Organiser</strong><small>Create and run events</small></span>
                    </label>
                </div>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-raceday w-100">Create account</button>
        </form>

        <p class="mt-3 mb-0 small">Already registered? <a asp-action="Login">Log in</a></p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
