@model ParticipantEventsViewModel
@{
    ViewData["Title"] = "Events";
}
<div class="page-header">
    <h1>Upcoming events</h1>
    <p>Find your next run, walk or ride.</p>
</div>

<form method="get" asp-action="Index" class="filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label for="Search" class="form-label">Search</label>
            <input id="Search" name="Search" value="@Model.Filter.Search" class="form-control" placeholder="Name, location or keyword" />
        </div>
        <div class="col-md-2">
            <label for="Type" class="form-label">Type</label>
            <select id="Type" name="Type" class="form-select">
                <option value="">All</option>
                @foreach (var t in EventOptions.Types)
                {
                    <option value="@t" selected="@(Model.Filter.Type == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label for="From" class="form-label">From</label>
            <input id="From" name="From" type="date" value="@(Model.Filter.From?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-2">
            <label for="To" class="form-label">To</label>
            <input id="To" name="To" type="date" value="@(Model.Filter.To?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-raceday flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-dark" title="Clear filters">Clear</a>
        </div>
    </div>
    <div class="form-check mt-2">
        <input class="form-check-input" type="checkbox" id="IncludePast" name="IncludePast" value="true" checked="@Model.Filter.IncludePast" />
        <label class="form-check-label small" for="IncludePast">Include past events</label>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="empty-state">
        <p>No events match your filters.</p>
        <a asp-action="Index" class="btn btn-raceday">Show all upcoming events</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-sm-6 col-lg-4"><partial name="_EventCard" model="ev" /></div>
        }
    </div>
}
