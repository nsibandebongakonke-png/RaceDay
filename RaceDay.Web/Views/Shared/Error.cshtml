@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="empty-state error-state">
    <h1>Something went wrong</h1>
    <p>Sorry - we hit a problem while loading that page. Please try again in a moment.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-raceday">Back to home</a>
</div>
