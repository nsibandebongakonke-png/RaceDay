@model EventSummaryDto
@{
    var banner = Url.ImageUrl(Model.BannerImage);
}
<div class="card event-card h-100">
    @if (banner is not null)
    {
        <img src="@banner" class="event-banner" alt="Banner for @Model.Name" loading="lazy" />
    }
    else
    {
        <div class="event-banner event-banner-placeholder"><span>@Model.EventType</span></div>
    }
    <div class="card-body d-flex flex-column">
        <div class="mb-2">
            <span class="type-pill type-@Model.EventType.ToLowerInvariant()">@Model.EventType</span>
            <span class="text-muted small ms-1">@Model.Distance</span>
        </div>
        <h3 class="card-title h5">@Model.Name</h3>
        <p class="event-meta mb-1">@Model.Date.ToString("ddd, d MMM yyyy · HH:mm")</p>
        <p class="event-meta mb-3">@Model.Location</p>
        <div class="mt-auto">
            <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-raceday btn-sm">View event</a>
        </div>
    </div>
</div>
