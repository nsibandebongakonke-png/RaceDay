@{
    var session = Context.Session;
    var signedIn = session.IsAuthenticated();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string Active(params string[] names) => names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "active" : string.Empty;
    var avatar = Url.ImageUrl(session.GetProfilePicture());
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;1,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-raceday">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (signedIn && session.IsOrganiser())
                        {
                            <li class="nav-item"><a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("ManageEvents")" asp-controller="ManageEvents" asp-action="Index">Events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Categories")" asp-controller="Categories" asp-action="Index">Categories</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Enrolments")" asp-controller="Enrolments" asp-action="Index">Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Results")" asp-controller="Results" asp-action="Index">Results</a></li>
                        }
                        else if (signedIn && session.IsParticipant())
                        {
                            <li class="nav-item"><a class="nav-link @Active("Events")" asp-controller="Events" asp-action="Index">Events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("MyEnrolments")" asp-controller="MyEnrolments" asp-action="Index">My Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @Active("MyResults")" asp-controller="MyResults" asp-action="Index">My Results</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center">
                        @if (signedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-user @Active("Profile")" asp-controller="Profile" asp-action="Index">
                                    @if (avatar is not null)
                                    {
                                        <img src="@avatar" class="avatar avatar-sm" alt="" />
                                    }
                                    else
                                    {
                                        <span class="avatar avatar-sm avatar-initials">@UiHelpers.Initials(session.GetFullName())</span>
                                    }
                                    <span>@session.GetFullName()</span>
                                    <span class="role-pill">@session.GetRole()</span>
                                </a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Account")" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item ms-lg-2"><a class="btn btn-raceday btn-sm" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">&copy; 2026 RaceDay &middot; Run. Walk. Ride. Race day starts here.</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
